#!/bin/sh
set -eu
if command -v python >/dev/null 2>&1 && python -c 'import sys; assert sys.version_info.major == 3' >/dev/null 2>&1; then
    python tools/scan-secrets.py
elif command -v python3 >/dev/null 2>&1; then
    python3 tools/scan-secrets.py
else
    echo 'Secret scan requires Python 3; commit blocked.' >&2
    exit 1
fi
